<Project>
  <!-- Copy to Directory.Build.props and set your local paths. -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <!-- Or point ManagedDir at dedicated: ...\Valheim dedicated server\valheim_server_Data\Managed -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(ValheimDir)\BepInEx</BepInExDir>
  </PropertyGroup>
</Project>
